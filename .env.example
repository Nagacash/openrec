# OpenRec — Naga Codex
# Build & signing configuration
# Copy to .env and fill in your values for code-signed distribution
# For local personal builds, only APP_NAME and BUNDLE_ID are needed

APP_NAME=OpenRec
BUNDLE_ID=cloud.nagacodex.openrec

# Code signing (only needed to distribute to others without Gatekeeper warning)
APPLE_ID=
TEAM_ID=
SIGN_IDENTITY="Developer ID Application: YOUR NAME (TEAM_ID)"
CSC_NAME="YOUR NAME (TEAM_ID)"
NOTARY_PROFILE=OpenRec-notary
APPLE_APP_SPECIFIC_PASSWORD=
